# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=production
# Public base URL of your deployed server (e.g. https://attendance.pess.co.in or http://<SERVER_IP>:3000)
BASE_URL=https://attendance.pess.co.in

# Secret key used for signing JWT access tokens (replace with a long, secure random string)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_JWT_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# ==============================================================================
# DATABASE CONFIGURATION (Microsoft SQL Server / MSSQL)
# ==============================================================================
DB_TYPE=mssql
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrongMssqlPassword123!
DB_DATABASE=attendance_prod

# Set to true on first run to automatically create tables, then set to false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Connection encryption settings for MS SQL
# Set DB_ENCRYPT=true for Azure SQL or SSL-enforced SQL instances
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ==============================================================================
# FILE UPLOAD & STORAGE CONFIGURATION
# ==============================================================================
# Local folder on the server where uploaded photos and punches are saved
UPLOAD_DIR=uploads
